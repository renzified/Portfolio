root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Knowledge-base pattern samples use comments as documentation, so their
# layout/placement can be unconventional. Disable every comment-related rule there.
[knowledgebase/pattern/**.{kt,kts}]
ktlint_standard_block-comment-initial-star-alignment = disabled
ktlint_standard_comment-spacing = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_discouraged-comment-location = disabled
ktlint_standard_kdoc = disabled
ktlint_standard_kdoc-wrapping = disabled
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_no-single-line-block-comment = disabled
ktlint_standard_type-argument-comment = disabled
ktlint_standard_type-parameter-comment = disabled
ktlint_standard_value-argument-comment = disabled
ktlint_standard_value-parameter-comment = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2
